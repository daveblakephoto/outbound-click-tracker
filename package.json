{
  "name": "click-tracker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:analytics-config": "node scripts/sync-analytics-config.js",
    "sync:vendor-metadata": "node scripts/sync-vendor-metadata.js",
    "predeploy": "npm run sync:analytics-config && bash scripts/predeploy-check.sh",
    "smoke": "bash scripts/smoke-check.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --env production"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240419.0",
    "miniflare": "^3.20240419.0",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0",
    "wrangler": "^4.60.0"
  }
}
