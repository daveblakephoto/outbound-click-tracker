{
  "apiVersion": "1.0.0",
  "allowedPages": [
    "profile",
    "spotlight",
    "featured",
    "basic",
    "unpaid",
    "article"
  ],
  "allowedPlans": ["unpaid", "basic", "featured"],
  "allowedPlacements": ["spotlight", "editor_pick", "home_feature"],
  "allowedClickTypes": ["website", "instagram"],
  "internalDomains": ["startmyloveengine.com", "go.startmyloveengine.com"],
  "vendorSlugRegex": "^[a-z0-9-]+$",
  "defaultRanges": ["7d", "28d", "90d"],
  "cors": {
    "visitAllowedOrigins": [
      "https://startmyloveengine.com",
      "https://www.startmyloveengine.com"
    ],
    "exportAllowedOrigins": [
      "https://startmyloveengine.com",
      "https://www.startmyloveengine.com"
    ]
  },
  "endpoints": {
    "click": {
      "methods": ["POST"]
    }
  },
  "responses": {
    "stats": {
      "dataSource": ["ae", "kv", "cache"],
      "dataWarning": "string"
    },
    "export": {
      "headers": {
        "dataSource": "X-Data-Source",
        "dataWarning": "X-Data-Warning",
        "cache": "X-Cache"
      }
    },
    "health": {
      "status": ["ok", "degraded"],
      "fields": ["latencyMs", "lastError", "checkedAt"]
    }
  },
  "diagnostics": {
    "dataSourceHeader": "X-Data-Source",
    "dataWarningHeader": "X-Data-Warning",
    "cacheHeader": "X-Cache",
    "healthEndpoint": "/api/health/analytics-engine"
  }
}
