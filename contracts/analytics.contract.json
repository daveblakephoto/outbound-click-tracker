{
  "apiVersion": "1.1.0",
  "allowedPages": [
    "profile",
    "spotlight",
    "featured",
    "basic",
    "unpaid",
    "article",
    "agency-rates"
  ],
  "allowedPlans": ["unpaid", "basic", "featured"],
  "allowedPlacements": ["spotlight", "editor_pick", "home_feature"],
  "allowedClickTypes": ["website", "instagram"],
  "allowedEventTypes": ["view", "click", "submit", "error", "custom"],
  "eventNameRegex": "^[a-z0-9][a-z0-9_.-]{0,63}$",
  "sessionIdRegex": "^[A-Za-z0-9._:-]{6,128}$",
  "internalDomains": [
    "startmyloveengine.com",
    "go.startmyloveengine.com",
    "dave-blake.com",
    "staging.dave-blake.com"
  ],
  "vendorSlugRegex": "^[a-z0-9-]+$",
  "defaultRanges": ["7d", "28d", "90d"],
  "cors": {
    "visitAllowedOrigins": [
      "https://startmyloveengine.com",
      "https://www.startmyloveengine.com",
      "https://dave-blake.com",
      "https://www.dave-blake.com",
      "https://staging.dave-blake.com",
      "http://localhost:4321",
      "http://127.0.0.1:4321"
    ],
    "exportAllowedOrigins": [
      "https://startmyloveengine.com",
      "https://www.startmyloveengine.com",
      "https://smle.mocha.app",
      "https://dave-blake.com",
      "https://www.dave-blake.com",
      "https://staging.dave-blake.com",
      "http://localhost:5500",
      "http://127.0.0.1:5500",
      "http://localhost:4321",
      "http://127.0.0.1:4321"
    ]
  },
  "endpoints": {
    "event": {
      "methods": ["POST"]
    },
    "visit": {
      "methods": ["POST"]
    },
    "click": {
      "methods": ["POST"]
    }
  },
  "responses": {
    "stats": {
      "dataSource": ["ae", "cache"],
      "dataWarning": "string"
    },
    "export": {
      "headers": {
        "dataSource": "X-Data-Source",
        "dataWarning": "X-Data-Warning",
        "cache": "X-Cache"
      }
    },
    "health": {
      "status": ["ok", "degraded"],
      "fields": ["latencyMs", "lastError", "checkedAt"]
    }
  },
  "diagnostics": {
    "dataSourceHeader": "X-Data-Source",
    "dataWarningHeader": "X-Data-Warning",
    "cacheHeader": "X-Cache",
    "healthEndpoint": "/api/health/analytics-engine"
  }
}
